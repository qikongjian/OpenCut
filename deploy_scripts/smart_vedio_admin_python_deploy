PROJECT_NAME="smartvideo-admin-server-python"
BASE_DIR="/home/mf/apps/python-backend"
PORT=8181

PROFILE_ENV="main"
PROJECT_DIR="${BASE_DIR}/${PROJECT_NAME}"
DIST_DIR="${PROJECT_DIR}/dist"
CONTAINER_NAME="${PROJECT_NAME}-container-${PROFILE_ENV}"
IMAGE_NAME="${PROJECT_NAME}:${PROFILE_ENV}"
NEXUS_URL="https://repo.qikongjian.com/repository/python-tar-files/"
NEXUS_USER="admin"
NEXUS_PASS="YZ9Gq6=8\*G|?:,"

# Create directories
mkdir -p $PROJECT_DIR
mkdir -p $DIST_DIR
echo "Setting deployment directory to $PROJECT_DIR for the ${PROFILE_ENV} environment."

echo "Downloading tar file from Nexus..."
curl -u "${NEXUS_USER}:${NEXUS_PASS}" -O "${NEXUS_URL}/${PROJECT_NAME}-${PROFILE_ENV}.tar.gz"
if [ $? -ne 0 ]; then
    echo "Failed to download tar file from Nexus"
    exit 1
fi

echo "Extracting tar file to $DIST_DIR"
tar -xzvf "${PROJECT_NAME}-${PROFILE_ENV}.tar.gz" -C "$DIST_DIR" --strip-components=1
if [ $? -ne 0 ]; then
    echo "Failed to extract tar file"
    exit 1
fi

cd "$PROJECT_DIR"

# Create a temporary Dockerfile
echo "Creating Dockerfile..."
cat > Dockerfile << 'EOF'
#FROM python:3.12
FROM python:3.13-slim

RUN apt-get update && \
    apt-get install -f -y && \
    apt-get upgrade -y

# Install build dependencies
RUN apt-get install -y \
    gcc \
    g++ \
    build-essential \
    && rm -rf /var/lib/apt/lists/*


WORKDIR /project

RUN rm -f /etc/apt/sources.list.d/* && \
    echo "deb http://mirrors.aliyun.com/debian/ bookworm main contrib non-free" > /etc/apt/sources.list && \
    echo "deb http://mirrors.aliyun.com/debian/ bookworm-updates main contrib non-free" >> /etc/apt/sources.list && \
    echo "deb http://mirrors.aliyun.com/debian-security bookworm-security main contrib non-free" >> /etc/apt/sources.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg && \
    rm -rf /var/lib/apt/lists/*

# Copy requirements.txt
# 安装系统依赖和编译工具
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY dist/requirements.txt .

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple

# Copy the rest of the application
COPY dist .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
# 启动应用并将日志输出到文件
EOF

# Build Docker image first
echo "Building Docker image..."
docker build -t $IMAGE_NAME .

if [ $? -ne 0 ]; then
    echo "Failed to build Docker image"
    exit 1
fi

# Clean up Dockerfile
rm Dockerfile

# Stop and remove existing container only after successful build
if [ $(docker ps -a -q -f name=^/${CONTAINER_NAME}$) ]; then
    echo "Container $CONTAINER_NAME exists, stopping..."
    docker stop $CONTAINER_NAME
    echo "Removing existing container..."
    docker rm $CONTAINER_NAME
fi

# 检查 env 文件是否存在，如果不存在，则提示并退出
if [ ! -f ${BASE_DIR}/envs/.${PROJECT_NAME}.env ]; then
    echo "env 文件: ${BASE_DIR}/envs/.${PROJECT_NAME}.env 不存在，请检查文件是否存在"
    exit 1
fi

# Run the new container
echo "Starting new container..."
docker run -d \
    -p $PORT:8000 \
    -e TZ=Asia/Shanghai \
    --name $CONTAINER_NAME \
    --volume ${PROJECT_DIR}/logs:/project/logs \
    --restart unless-stopped \
    --env-file ${BASE_DIR}/envs/.${PROJECT_NAME}.env \
    $IMAGE_NAME

if [ $? -ne 0 ]; then
    echo "Failed to start new container"
    exit 1
fi

## 循环调用直到成功或者超时
for i in {1..30}; do
    if curl -s http://localhost:$PORT/health | grep -q "healthy"; then
        echo "Deployment ok"
        break
    fi
    echo "Waiting for deployment to complete..."
    sleep 1
done
# 如果超时，则提示并退出
if [ $i -eq 30 ]; then
    echo "Deployment failed"
    exit 1
fi

# 清理未使用的镜像
docker image prune -a -f
echo "Deployment completed at $(date)"
