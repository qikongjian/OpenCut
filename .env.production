# OpenCut 生产环境配置
# 请根据实际情况修改以下配置

# 应用基础配置
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# 数据库配置 - 使用Docker容器内的PostgreSQL
DATABASE_URL="postgresql://opencut:opencutthegoat@postgres:5432/opencut"

# 认证配置 - 生产环境需要修改为实际域名
BETTER_AUTH_SECRET="opencut-prod-2025-secure-auth-key-$(date +%s)-random"
NEXT_PUBLIC_BETTER_AUTH_URL="http://39.105.24.90"

# Redis 配置 - 使用Docker容器内的Redis
UPSTASH_REDIS_REST_URL="http://redis:6379"
UPSTASH_REDIS_REST_TOKEN="production-redis-token"

# Freesound API 配置 - 可选，用于音效搜索
FREESOUND_CLIENT_ID=""
FREESOUND_API_KEY=""

# Cloudflare R2 配置 - 可选，用于文件存储
CLOUDFLARE_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="opencut-production"

# Modal 转录服务 - 可选，用于AI语音转录
MODAL_TRANSCRIPTION_URL=""

# AI剪辑计划API配置
AI_EDITING_PLAN_API_URL="https://77.smartvideo.py.qikongjian.com"
NEXT_PUBLIC_AI_EDITING_PLAN_API_URL="https://77.smartvideo.py.qikongjian.com"

# 其他配置
ANALYZE="false"

# 数据库凭据（用于Docker Compose）
POSTGRES_USER=opencut
POSTGRES_PASSWORD=opencutthegoat
POSTGRES_DB=opencut

# Redis配置（用于Docker Compose）
REDIS_PASSWORD=opencut-redis-password
